# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# marimo local session/checkpoint cache (editor runtime state, not source)
__marimo__/

# Local dataset caches are not versioned. Extraction's compact Sangraha
# sample, download script, manifest, and measurements remain tracked under
# extraction/data/; full raw and extraction-output JSONLs stay local.
data/*
extraction/data/*
!extraction/data/c4_en_html_evaluation/
!extraction/data/sangraha_hi_verified_30m/
extraction/data/*/raw.jsonl
extraction/data/*/raw_html.jsonl
extraction/data/*/extraction_only/*.jsonl
extraction/data/*/extraction_only/impl/*.jsonl
*.parquet
.hf_cache/

# Local Netlify folder
.netlify

# OMP shell sidecars are local execution logs, not assignment artifacts.
quality-filtering/omp-session-*/*.bash-original.log
