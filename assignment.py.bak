    mo.md(r"""
    # S4 Assignment · Data Cleaning

    **Goal:** Netlify widget showing the 8 cleanups applied to one ~10–100M corpus.

    ## Locked dataset
    | | |
    |---|---|
    | HF | `ai4bharat/sangraha` |
    | Config / split | `verified` / `hin` |
    | Budget | **~30M tokens** (stream + stop) |
    | Why | Session 3 Indic corpus, open, document-level web Hindi, enough dirt for the funnel |

    ## 8 strategies
    1. Extract (residual) · 2. Normalize (keep ZWJ/ZWNJ) · 3. Language ID · 4. Quality · 5. Dedup · 6. PII · 7. Decontam · 8. Manifest
    """)
    return


@app.cell
def download_guide(mo):
    mo.md(r"""
    ## Sample build
    Stream `verified/hin`, **shuffle** (`seed=42`, `buffer_size=10_000`), stop at ~30M lower-proxy tokens, write `data/sangraha_hi_verified_30m/`.

    Nothing downloads until you click the button.
    """)
    return


@app.cell
def sample_config():

    from __future__ import annotations

    from pathlib import Path
    import json
    import os
    import time

    DATASET_ID = "ai4bharat/sangraha"
    DATASET_CONFIG = "verified"
    DATASET_SPLIT = "hin"
    TOKEN_BUDGET = 30_000_000
    MAX_DOCS_SAFETY = 2_000_000
    SHUFFLE_SEED = 42
    SHUFFLE_BUFFER = 10_000

    PROJECT_ROOT = Path("/home/rev/timepass/dataset-cleaning-assignment")
    DATA_DIR = PROJECT_ROOT / "data" / "sangraha_hi_verified_30m"
    HF_CACHE = PROJECT_ROOT / ".hf_cache"

    os.environ.setdefault("HF_HOME", str(HF_CACHE))
    os.environ.setdefault("HF_DATASETS_CACHE", str(HF_CACHE / "datasets"))
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    HF_CACHE.mkdir(parents=True, exist_ok=True)

    sample_cfg = {
        "dataset": DATASET_ID,
        "config": DATASET_CONFIG,
        "split": DATASET_SPLIT,
        "token_budget": TOKEN_BUDGET,
        "shuffle_seed": SHUFFLE_SEED,
        "shuffle_buffer": SHUFFLE_BUFFER,
        "data_dir": str(DATA_DIR),
    }
    sample_cfg

    return (
        DATASET_CONFIG,
        DATASET_ID,
        DATASET_SPLIT,
        DATA_DIR,
        MAX_DOCS_SAFETY,
        Path,
        SHUFFLE_BUFFER,
        SHUFFLE_SEED,
        TOKEN_BUDGET,
        json,
        time,
    )


@app.cell
def sample_helpers(
    DATASET_CONFIG,
    DATASET_ID,
    DATASET_SPLIT,
    DATA_DIR,
    MAX_DOCS_SAFETY,
    Path,
    SHUFFLE_BUFFER,
    SHUFFLE_SEED,
    TOKEN_BUDGET,
    json,
    time,
):

    from datasets import load_dataset
    from tqdm.auto import tqdm


    def estimate_tokens(text: str) -> tuple[int, int]:
        if not text:
            return 0, 0
        lo = max(1, len(text.split()))
        hi = max(lo, len(text) // 3)
        return lo, hi


    def stream_sangraha_sample(
        *,
        token_budget: int = TOKEN_BUDGET,
        max_docs: int = MAX_DOCS_SAFETY,
        out_dir: Path = DATA_DIR,
        seed: int = SHUFFLE_SEED,
        buffer_size: int = SHUFFLE_BUFFER,
    ) -> dict:
        """Stream verified/hin with shuffle; stop at token budget; write JSONL + manifest."""
        out_dir = Path(out_dir)
        out_dir.mkdir(parents=True, exist_ok=True)
        jsonl_path = out_dir / "sample.jsonl"
        meta_path = out_dir / "sample_manifest.json"

        ds = load_dataset(
            DATASET_ID,
            name=DATASET_CONFIG,
            split=DATASET_SPLIT,
            streaming=True,
        )
        # Avoid head-of-stream bias (one shard/source dominating the sample).
        ds = ds.shuffle(seed=seed, buffer_size=buffer_size)

        n_docs = 0
        n_chars = 0
        tok_lo = 0
        tok_hi = 0
        type_counts: dict[str, int] = {}
        t0 = time.time()

        with jsonl_path.open("w", encoding="utf-8") as f:
            bar = tqdm(total=token_budget, unit="tok≈", desc="sangraha hi sample")
            for row in ds:
                text = row.get("text") or ""
                dtype = row.get("type") or "unknown"
                lo, hi = estimate_tokens(text)
                f.write(
                    json.dumps(
                        {
                            "doc_id": row.get("doc_id"),
                            "type": dtype,
                            "text": text,
                            "char_len": len(text),
                            "tok_lo": lo,
                            "tok_hi": hi,
                        },
                        ensure_ascii=False,
                    )
                    + "\n"
                )
                n_docs += 1
                n_chars += len(text)
                tok_lo += lo
                tok_hi += hi
                type_counts[dtype] = type_counts.get(dtype, 0) + 1
                bar.update(lo)
                if tok_lo >= token_budget or n_docs >= max_docs:
                    break
            bar.close()

        manifest = {
            "dataset": DATASET_ID,
            "config": DATASET_CONFIG,
            "split": DATASET_SPLIT,
            "license": "cc-by-4.0",
            "streaming": True,
            "shuffle_seed": seed,
            "shuffle_buffer": buffer_size,
            "token_budget_target": token_budget,
            "docs_written": n_docs,
            "chars_total": n_chars,
            "tokens_proxy_lower": tok_lo,
            "tokens_proxy_upper": tok_hi,
            "type_counts": type_counts,
            "jsonl_path": str(jsonl_path),
            "elapsed_sec": round(time.time() - t0, 2),
        }
        meta_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False), encoding="utf-8")
        return manifest


    "ok"

    return (stream_sangraha_sample,)


@app.cell
def sample_ui(
    DATASET_CONFIG,
    DATASET_ID,
    DATASET_SPLIT,
    SHUFFLE_SEED,
    TOKEN_BUDGET,
    mo,
):

    run_sample_btn = mo.ui.run_button(label="Build ~30M-token Sangraha hi sample")
    mo.vstack([
        mo.md(f"`{DATASET_ID}` · `{DATASET_CONFIG}/{DATASET_SPLIT}` · budget {TOKEN_BUDGET:,} · seed {SHUFFLE_SEED}"),
        run_sample_btn,
    ])

    return (run_sample_btn,)


@app.cell
def sample_run(mo, run_sample_btn, stream_sangraha_sample):

    sample_manifest = None
    if run_sample_btn.value:
        sample_manifest = stream_sangraha_sample()
        sample_manifest
    else:
        mo.md("_Click the button to stream + sample. No data pulled until then._")

    return


if __name__ == "__main__":
    app.run()
