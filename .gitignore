# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# marimo local session/checkpoint cache (editor runtime state, not source)
__marimo__/

# Local dataset caches are not versioned. Extraction's compact Sangraha
# sample, download script, manifest, and measurements remain tracked under
# extraction/data/; full raw and extraction-output JSONLs stay local.
data/*
!quality-filtering/data/
quality-filtering/data/sarvam_quality_classifier/*
!quality-filtering/data/sarvam_quality_classifier/classifier_summary.json
!quality-filtering/data/sarvam_quality_classifier/held_out_predictions.jsonl
!quality-filtering/data/sarvam_quality_classifier/held_out_controls.jsonl
!quality-filtering/data/sarvam_quality_classifier/sarvam_source_annotations.jsonl
!quality-filtering/data/sarvam_quality_classifier/synthetic_bad_examples.jsonl
!quality-filtering/data/sarvam_quality_classifier/unverified_pool.jsonl
!quality-filtering/data/sarvam_quality_classifier/unverified_candidate.jsonl
extraction/data/*
!extraction/data/c4_en_html_evaluation/
!extraction/data/sangraha_hi_verified_30m/
extraction/data/*/raw.jsonl
extraction/data/*/raw_html.jsonl
extraction/data/*/extraction_only/*.jsonl
extraction/data/*/extraction_only/impl/*.jsonl
deduplication/data/*
!deduplication/data/.gitignore
!deduplication/data/README.md
!deduplication/data/selection_manifest.json
!deduplication/data/dedup_metrics.json

# PII-scrubbing stage: the probe cache is 109MB of Sangraha rows, rebuildable
# from the pinned revision by data/build_pii_probe_cache.py, so only the build
# script, provenance manifest, hand-labelled gold set, and measurements are
# tracked. Upstream reference clones read for citations are not vendored.
pii-scrubbing/data/*
!pii-scrubbing/data/build_pii_probe_cache.py
!pii-scrubbing/data/probe_manifest.json
!pii-scrubbing/data/metrics.json
!pii-scrubbing/data/token_cost.json
!pii-scrubbing/data/gold_labelled.jsonl
pii-scrubbing/bigcode-dataset/
pii-scrubbing/data-preparation/

# Decontamination stage: the 12,000-document Sangraha stride probe (67MB) and
# the cached Hindi eval suite (19MB) are derived data, rebuildable from the
# pinned revisions by data/build_decontamination_cache.py, so only the build
# script, provenance manifest, and frozen measurements are tracked.
decontamination/data/*
!decontamination/data/build_decontamination_cache.py
!decontamination/data/probe_manifest.json
!decontamination/data/measurement_results.json

# Manifest/provenance stage: the built slice, manifests, and metrics are
# tracked; the tiktoken BPE cache and per-shard splits are local scratch.
# The root-anchored data/* rule above does not reach nested stage folders.
manifest-provenance/data/.tiktoken_cache/
manifest-provenance/data/shards/
*.parquet
.hf_cache/

# Local Netlify folder
.netlify

# OMP shell sidecars are local execution logs, not assignment artifacts.
quality-filtering/omp-session-*/*.bash-original.log
